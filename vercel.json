{
  "rewrites": [
    {
      "source": "/app/:file.(png|jpg|jpeg|gif|svg|webp|ico)",
      "destination": "/:file.$1"
    },
    { "source": "/app/static/:path*", "destination": "/static/:path*" },
    { "source": "/app/manifest.json", "destination": "/manifest.json" },
    { "source": "/app/(.*)", "destination": "/index.html" }
  ]
}
