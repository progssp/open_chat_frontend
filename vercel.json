{
  "rewrites": [
    {
      "source": "/app/:asset.(png|jpg|jpeg|gif|svg|webp|ico)",
      "destination": "/:asset"
    },
    { "source": "/app/static/:path*", "destination": "/static/:path*" },
    { "source": "/app/manifest.json", "destination": "/manifest.json" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
