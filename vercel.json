{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/system/api/:path*",
      "destination": "https://system.tailf90f7d.ts.net/system/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://system.tailf90f7d.ts.net/storage/:path*"
    },
    {
      "source": "/app/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/app/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/app/asset-manifest.json",
      "destination": "/asset-manifest.json"
    },
    { "source": "/app/manifest.json", "destination": "/manifest.json" },
    { "source": "/app/(.*)", "destination": "/index.html" }
  ]
}
